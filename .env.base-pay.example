# Base Pay Configuration
# Copy this file to .env and fill in your values

# Your wallet address to receive USDC payments
# This is a public address, safe to commit
# Choose one of your addresses below:
VITE_BASE_PAY_RECIPIENT_ADDRESS=0x3390cc17f73e29752268043c4F8421Cb53579989
# Alternative address: 0xEC2525DDA8F79c8D7534cef588ae04F183101Da4

# Set to true for Base Sepolia testnet, false for Base mainnet
VITE_BASE_PAY_TESTNET=true

# Existing CryptoWebb Configuration
VITE_BACKEND_URL=http://localhost:8080
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ... rest of your existing env vars ...
