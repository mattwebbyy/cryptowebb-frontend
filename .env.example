# Environment Configuration
# Options: development, staging, production
VITE_ENVIRONMENT=development

# Backend API base URL (no trailing slash)
VITE_BACKEND_URL=http://localhost:8080
# WebSocket base URL (optional — derived from VITE_BACKEND_URL when unset)
VITE_WS_URL=

# Stripe Public Key
VITE_STRIPE_PUBLIC_KEY=

# Basic Tier Price IDs
VITE_STRIPE_BASIC_MONTHLY_PRICE_ID=
VITE_STRIPE_BASIC_SIX_MONTHS_PRICE_ID=
VITE_STRIPE_BASIC_YEARLY_PRICE_ID=

# Pro Tier Price IDs
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=
VITE_STRIPE_PRO_SIX_MONTHS_PRICE_ID=
VITE_STRIPE_PRO_YEARLY_PRICE_ID=

# Enterprise Tier Price IDs
VITE_STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
VITE_STRIPE_ENTERPRISE_SIX_MONTHS_PRICE_ID=
VITE_STRIPE_ENTERPRISE_YEARLY_PRICE_ID=

VITE_USE_MOCK_DATA=false

# OnchainKit API Key (for Coinbase Commerce crypto payments)
VITE_ONCHAINKIT_API_KEY=

# Coinbase Commerce API Key
VITE_COINBASE_COMMERCE_API_KEY=

VITE_BASE_PAY_RECIPIENT_ADDRESS=
# Set to true for Base Sepolia testnet, false for Base mainnet
VITE_BASE_PAY_TESTNET=true
